#!/usr/bin/env bash
# Exit 0 if a commit on <onto> has exactly the same tree as <commit>.
#
# Squash, rebase and cherry-pick all rewrite commit SHAs, so "is my work on
# main?" cannot be answered by SHA or by `git branch --merged`. A tree hash is a
# content hash of the whole worktree, so comparing trees answers it directly:
# equal tree means every file is byte-identical, whatever the history looks like.
#
# Usage: git tree-merged [<commit>] [--onto <ref>] [--fetch] [-q]
#
#   <commit>      commit to look for (default HEAD)
#   --onto <ref>  branch to search (default origin/main)
#   --fetch       refresh <ref> from its remote first (network)
#   -q            no output, exit code only
#   --self-test   run the built-in checks and exit
#
# Exit: 0 found, 1 not found, 2 usage/setup error.

set -euo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

COMMIT=HEAD
ONTO=origin/main
FETCH=false
QUIET=false

while [ $# -gt 0 ]; do
    case "$1" in
        --onto) ONTO="${2:?--onto needs a ref}"; shift 2 ;;
        --fetch) FETCH=true; shift ;;
        -q|--quiet) QUIET=true; shift ;;
        --self-test) shift; self_test=true; break ;;
        -h|--help) sed -n '2,19p' "${SELF}" | sed 's/^# \?//'; exit 0 ;;
        -*) echo "unknown flag: $1" >&2; exit 2 ;;
        *) COMMIT="$1"; shift ;;
    esac
done

say() { [ "${QUIET}" = true ] || echo "$@"; }

run() {
    if [ "${FETCH}" = true ]; then
        # origin/main -> fetch main from origin; a local ref is left alone.
        case "${ONTO}" in
            */*) git fetch -q "${ONTO%%/*}" "${ONTO#*/}" ;;
        esac
    fi

    local tree
    tree=$(git rev-parse --verify "${COMMIT}^{tree}") || { echo "no such commit: ${COMMIT}" >&2; exit 2; }
    git rev-parse --verify --quiet "${ONTO}" >/dev/null || { echo "no such ref: ${ONTO}" >&2; exit 2; }

    # First commit on <onto> whose tree matches. Stops at the first hit.
    local match
    # Process substitution, not a pipe: awk exits at the first match, which would
    # SIGPIPE git log and trip `pipefail` into a nondeterministic exit 141.
    match=$(awk -v t="${tree}" '$1==t {print $2; exit}' < <(git log --format='%T %H' "${ONTO}"))

    if [ -n "${match}" ]; then
        say "✅ tree ${tree:0:12} is on ${ONTO} as ${match:0:12}"
        say "   $(git log -1 --format='%s' "${match}")"
        return 0
    fi
    say "❌ tree ${tree:0:12} (${COMMIT}) is not on ${ONTO}"
    return 1
}

# --- self-test -------------------------------------------------------------
# Builds a throwaway repo, squash-merges a branch, and asserts both verdicts.
if [ "${self_test:-false}" = true ]; then
    tmp=$(mktemp -d); trap 'rm -rf "${tmp}"' EXIT
    export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t
    git init -q -b main "${tmp}/r"
    cd "${tmp}/r"
    # Hermetic: ignore the developer's global hooks/config so the test is the
    # same everywhere (a global core.hooksPath otherwise fires in this repo).
    mkdir -p "${tmp}/nohooks"; git config core.hooksPath "${tmp}/nohooks"
    echo base > f; git add f; git commit -qm base
    git checkout -qb feat
    echo change > f; git add f; git commit -qm one
    echo more >> f; git add f; git commit -qm two          # two commits, one tree
    feat_tree=$(git rev-parse HEAD^{tree})
    git checkout -q main
    git merge -q --squash feat >/dev/null && git commit -qm "squashed"  # rewrites SHAs
    [ "$(git rev-parse HEAD^{tree})" = "${feat_tree}" ] || { echo "self-test setup broken"; exit 2; }

    fail=0
    "${SELF}" feat --onto main -q || { echo "FAIL: squashed tree not found"; fail=1; }
    git checkout -q feat; echo drift >> f; git add f; git commit -qm drift
    if "${SELF}" feat --onto main -q; then echo "FAIL: drifted tree reported as merged"; fail=1; fi

    [ "${fail}" -eq 0 ] && echo "✅ git-tree-merged self-test passed"
    exit "${fail}"
fi

run
